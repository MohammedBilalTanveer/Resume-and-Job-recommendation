# Backend Configuration

# MongoDB Database
# Local: mongodb://localhost:27017
# MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=resume_ats

# Security - IMPORTANT: Change this in production!
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars

# Google OAuth (optional)
# Get credentials from: https://console.developers.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (optional)
# Get credentials from: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Frontend URL (for OAuth redirects)
FRONTEND_URL=http://localhost:3000

# OpenAI API (optional - for enhanced analysis)
OPENAI_API_KEY=

# Job APIs (optional)
ADZUNA_APP_ID=
ADZUNA_API_KEY=
JOOBLE_API_KEY=


# OpenAI model used for resume recommendations
OPENAI_MODEL=gpt-4o-mini

# Semantic matching model (~350 MB extra RAM). Use "off" on 512 MB hosts (e.g. Render free).
ATS_SEMANTIC_MODEL=on

# Extra allowed frontend origins (comma-separated) and an optional regex, e.g. for Vercel previews
CORS_ORIGINS=
CORS_ORIGIN_REGEX=
